# Names only. Copy the values into the files named below; never commit them.

# backend/.env (doc: `export GOOGLE_API_KEY=...`; start-all.sh passes it with --env-file)
GOOGLE_API_KEY=
GOOGLE_GEMINI_BASE_URL=http://localhost:8129   # HARNESS: the Gemini pool (tools/gemini_pool.py)

# my-copilot-app/.env.intelligence (Threads pages: the runtime's CopilotKitIntelligence)
CPK_INTELLIGENCE_API_KEY=

# Gemini pool (local): GEMINI_POOL_KEYFILES=<paths outside the repo> or GEMINI_POOL_KEYS (CI secrets)
# GEMINI_POOL_OPENAI_KEY=   last-resort OpenAI fallback
# Pipeline only: FISH_API_KEY (narration TTS)
